---
import "@/styles/global.css";

import { AppShell } from "@/components/layout/app-shell";
import ThemeScript from "@/components/layout/theme-script.astro";
import { getLessonsByLevel } from "@/lib/content";
import { LEVEL_INFO, LEVELS, PILLAR_INFO, PILLARS } from "@/lib/taxonomy";

interface Props {
  description?: string;
  title: string;
}

const {
  title,
  description = "A complete, easy-to-follow English grammar course from A1 to C2.",
} = Astro.props;
const byLevel = await getLessonsByLevel();

const levels = LEVELS.map((id) => ({
  id,
  lessons: byLevel[id]
    .toSorted((a, b) => a.data.number - b.data.number)
    .map((l) => ({
      href: `/lessons/${l.id}`,
      number: l.data.number,
      title: l.data.title,
    })),
  title: LEVEL_INFO[id].title,
}));
const pillars = PILLARS.map((id) => {
  const p = PILLAR_INFO[id];
  return { family: p.family, id, number: p.number, short: p.short };
});
const currentPath = Astro.url.pathname.replace(/\/$/u, "") || "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1" name="viewport">
    <meta content={description} name="description">
    <meta content="light dark" name="color-scheme">
    <link href="/favicon.svg" rel="icon" type="image/svg+xml">
    <title>
      {title === "Home"
        ? "English Grammar Mastery"
        : `${title} · Grammar Mastery`}
    </title>
    <ThemeScript />
  </head>
  <body>
    <a
      class="focus:bg-primary focus:text-primary-foreground sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:px-4 focus:py-2"
      href="#content"
      >Skip to content</a
    >
    <AppShell
      currentPath={currentPath}
      levels={levels}
      pillars={pillars}
      client:load
    >
      <div
        class="mx-auto flex w-full max-w-5xl min-w-0 flex-1 flex-col gap-8 px-4 py-8 sm:px-8 sm:py-10"
        id="content"
        tabindex="-1"
      >
        <slot />
      </div>
    </AppShell>
  </body>
</html>
