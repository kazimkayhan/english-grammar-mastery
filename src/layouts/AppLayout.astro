---
import "@/styles/global.css"

import ThemeScript from "@/components/layout/ThemeScript.astro"
import { AppShell } from "@/components/layout/AppShell"
import { getLessonsByLevel } from "@/lib/content"
import { LEVEL_INFO, LEVELS, PILLAR_INFO, PILLARS } from "@/lib/taxonomy"

interface Props {
  title: string
  description?: string
}

const { title, description = "A complete, easy-to-follow English grammar course from A1 to C2." } = Astro.props
const byLevel = await getLessonsByLevel()

const levels = LEVELS.map((id) => ({ id, title: LEVEL_INFO[id].title, count: byLevel[id].length }))
const pillars = PILLARS.map((id) => {
  const p = PILLAR_INFO[id]
  return { id, number: p.number, short: p.short, family: p.family }
})
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title === "Home" ? "English Grammar Mastery" : `${title} · Grammar Mastery`}</title>
    <ThemeScript />
  </head>
  <body>
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground"
      >Skip to content</a
    >
    <AppShell client:load currentPath={currentPath} levels={levels} pillars={pillars}>
      <div id="content" tabindex="-1" class="mx-auto flex w-full max-w-5xl min-w-0 flex-1 flex-col gap-8 px-4 py-8 sm:px-8 sm:py-10">
        <slot />
      </div>
    </AppShell>
  </body>
</html>
