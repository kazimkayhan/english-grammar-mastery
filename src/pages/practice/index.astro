---
import AppLayout from "@/layouts/app-layout.astro";
import { getLessons } from "@/lib/content";
import {
  FAMILY_INFO,
  LEVEL_INFO,
  LEVELS,
  PILLAR_INFO,
  PILLARS,
} from "@/lib/taxonomy";
import { plural } from "@/lib/text";

const lessons = await getLessons();
const countBy = (pred: (l: (typeof lessons)[number]) => boolean) =>
  lessons.filter(pred).reduce((n, l) => n + l.data.exercises.length, 0);
---

<AppLayout
  description="Mixed exercise sets by level and by grammar pillar, plus Level Checks."
  title="Practice"
>
  <header class="flex flex-col gap-3">
    <h1 class="font-heading text-4xl font-bold tracking-tight">Practice</h1>
    <p
      class="font-reading text-muted-foreground max-w-2xl text-lg lg:max-w-7xl"
    >
      Mixed sets pull exercises from many lessons, which is the best way to make
      grammar automatic. Scores show instantly and are never saved.
    </p>
  </header>

  <section aria-labelledby="checks-title" class="flex flex-col gap-3">
    <h2 class="font-heading text-2xl font-bold" id="checks-title">
      Level Checks
    </h2>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {LEVELS.map((level) => {
        const n = countBy((l) => l.data.level === level);
        return (
          <a
            aria-disabled={n ? undefined : "true"}
            class:list={[
              "flex flex-col gap-1 rounded-2xl border p-4",
              n ? "bg-card hover:bg-muted/50" : "border-dashed bg-transparent",
            ]}
            href={n ? `/practice/${level.toLowerCase()}` : undefined}
          >
            <span class="font-heading text-xl font-bold">
              {level} Level Check
            </span>
            <span class="text-muted-foreground text-sm">
              {LEVEL_INFO[level].title} ·{" "}
              {n ? `${plural(n, "exercise")} in the pool` : "coming soon"}
            </span>
          </a>
        );
      })}
    </div>
  </section>

  <section aria-labelledby="pillar-sets-title" class="flex flex-col gap-3">
    <h2 class="font-heading text-2xl font-bold" id="pillar-sets-title">
      By pillar
    </h2>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {PILLARS.map((pillar) => {
        const info = PILLAR_INFO[pillar];
        const fam = FAMILY_INFO[info.family];
        const n = countBy((l) => l.data.pillar === pillar);
        return (
          <a
            aria-disabled={n ? undefined : "true"}
            class:list={[
              "flex flex-col gap-1 rounded-2xl border p-4",
              n ? "bg-card hover:bg-muted/50" : "border-dashed bg-transparent",
            ]}
            href={n ? `/practice/${pillar}` : undefined}
            style={`border-left:4px solid ${fam.color}`}
          >
            <span class="font-bold">
              {info.number}. {info.short}
            </span>
            <span class="text-muted-foreground text-sm">
              {n ? plural(n, "exercise") : "coming soon"}
            </span>
          </a>
        );
      })}
    </div>
  </section>
</AppLayout>
