---
import { ExerciseSet } from "@/components/exercises/exercise-set";
import AppLayout from "@/layouts/app-layout.astro";
import { getLessons, lessonHref } from "@/lib/content";
import { seededShuffle } from "@/lib/exercises";
import {
  LEVEL_INFO,
  LEVELS,
  type Level,
  PILLAR_INFO,
  PILLARS,
  type Pillar,
} from "@/lib/taxonomy";
import { plural } from "@/lib/text";

export async function getStaticPaths() {
  const lessons = await getLessons();
  const levelSets = LEVELS.filter((level) =>
    lessons.some((l) => l.data.level === level)
  ).map((level) => ({
    params: { set: level.toLowerCase() },
    props: { key: level, kind: "level" as const },
  }));
  const pillarSets = PILLARS.filter((pillar) =>
    lessons.some((l) => l.data.pillar === pillar)
  ).map((pillar) => ({
    params: { set: pillar },
    props: { key: pillar, kind: "pillar" as const },
  }));
  return [...levelSets, ...pillarSets];
}

const { kind, key } = Astro.props as { kind: "level" | "pillar"; key: string };
const lessons = (await getLessons()).filter((l) =>
  kind === "level" ? l.data.level === key : l.data.pillar === key
);
const pool = lessons.flatMap((l) =>
  l.data.exercises.map((ex) => ({ ex, lesson: l }))
);
const size = kind === "level" ? 25 : 20;
const picked = seededShuffle(pool, `${kind}-${key}-${pool.length}`).slice(
  0,
  size
);
const title =
  kind === "level"
    ? `${key} Level Check`
    : `${PILLAR_INFO[key as Pillar].title}: mixed practice`;
const subtitle =
  kind === "level"
    ? `${LEVEL_INFO[key as Level].title}. ${plural(picked.length, "exercise")} from across the level. Aim for 80% before moving on.`
    : `${plural(picked.length, "exercise")} from every level of this pillar.`;
---

<AppLayout description={subtitle} title={title}>
  <header class="flex flex-col gap-2">
    <a
      class="text-muted-foreground hover:text-foreground text-sm"
      href="/practice"
      >← All practice sets</a
    >
    <h1 class="font-heading text-3xl font-bold tracking-tight">{title}</h1>
    <p class="text-muted-foreground">{subtitle}</p>
  </header>

  <ExerciseSet
    exercises={picked.map((p) => p.ex)}
    seed={`${kind}-${key}`}
    title="Exercises"
    client:load
  />

  <section class="flex flex-col gap-2">
    <h2 class="font-heading text-lg font-bold">Lessons in this set</h2>
    <ul class="flex flex-wrap gap-2">
      {lessons.map((l) => (
        <li>
          <a
            class="bg-card hover:bg-muted/50 inline-flex rounded-full border px-3 py-1 text-sm"
            href={lessonHref(l)}
          >
            {l.data.level}.{l.data.number} {l.data.title}
          </a>
        </li>
      ))}
    </ul>
  </section>
</AppLayout>
