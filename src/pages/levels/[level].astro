---
import LinkButton from "@/components/common/link-button.astro";
import SyllabusList from "@/components/common/syllabus-list.astro";
import MapEmbed from "@/components/lesson/map-embed.astro";
import AppLayout from "@/layouts/app-layout.astro";
import { isolatePersian } from "@/lib/bidi";
import { getLessons, getSyllabus, sizeMinutes } from "@/lib/content";
import {
  FAMILIES,
  FAMILY_INFO,
  LEVEL_INFO,
  LEVELS,
  type Level,
  PILLAR_INFO,
} from "@/lib/taxonomy";
import { plural } from "@/lib/text";

export function getStaticPaths() {
  return LEVELS.map((name) => ({
    params: { level: name.toLowerCase() },
    props: { level: name },
  }));
}

const { level } = Astro.props as { level: Level };
const info = LEVEL_INFO[level];
const items = (await getSyllabus()).filter((s) => s.level === level);
const ready = items.filter((s) => s.lesson);
const hours = Math.round(
  items.reduce((n, s) => n + sizeMinutes(s.size), 0) / 60
);
const next = LEVELS[LEVELS.indexOf(level) + 1];
const hasExercises = (await getLessons()).some((l) => l.data.level === level);

const PERSIAN_NOTE = {
  full: "Every lesson has a full Persian explanation (توضیح کامل فارسی) you can open or hide.",
  none: "English only: you're ready. Grammar Tips still lists the traps for Persian speakers.",
  tip: "Lessons are in English with short Persian tips on the tricky points.",
};
---

<AppLayout description={info.canDo} title={`${level} · ${info.title}`}>
  <header class="flex flex-col gap-3">
    <p class="text-primary text-sm font-bold tracking-widest uppercase">
      Level {LEVELS.indexOf(level) + 1} of 6
    </p>
    <h1 class="font-heading text-4xl font-bold tracking-tight">
      {level}
      · {info.title}
    </h1>
    <p class="font-reading max-w-2xl text-lg lg:max-w-7xl">
      <strong>By the end you can:</strong>&nbsp;{info.canDo}
    </p>
    <p class="text-muted-foreground">
      {items.length}
      lessons · about {hours} hours · {info.weeks} weeks at an hour a day (the
      last week is review and the Level Check) ·
      {ready.length
        ? `${plural(ready.length, "lesson")} ready now`
        : "lessons are being written"}
    </p>
    <p
      class="bg-persian-soft rounded-2xl px-4 py-3 text-sm"
      set:html={isolatePersian(PERSIAN_NOTE[info.persian])}
    />
    <div class="flex flex-wrap gap-2">
      {ready[0]?.lesson && (
        <LinkButton href={`/lessons/${ready[0].lesson.id}`}>
          Start the first lesson
        </LinkButton>
      )}
      {hasExercises && (
        <LinkButton href={`/practice/${level.toLowerCase()}`} variant="outline">
          Level Check
        </LinkButton>
      )}
    </div>
  </header>

  <section aria-labelledby="levelmap-title" class="flex flex-col gap-3">
    <h2 class="font-heading text-2xl font-bold" id="levelmap-title">
      What's new at {level}
    </h2>
    <MapEmbed height={460} id={`level-${level.toLowerCase()}`} recall />
  </section>

  <section aria-labelledby="all-title" class="flex flex-col gap-3">
    <h2 class="font-heading text-2xl font-bold" id="all-title">
      All {level} lessons, in order
    </h2>
    <SyllabusList items={items} />
  </section>

  <section aria-labelledby="byfamily-title" class="flex flex-col gap-4">
    <h2 class="font-heading text-2xl font-bold" id="byfamily-title">
      The same lessons by family
    </h2>
    <div class="grid gap-4 md:grid-cols-2">
      {FAMILIES.map((f) => {
        const fam = FAMILY_INFO[f];
        const list = items.filter(
          (s) => PILLAR_INFO[s.pillar as keyof typeof PILLAR_INFO].family === f
        );
        return (
          <div
            class="bg-card flex flex-col gap-2 rounded-2xl border p-4"
            style={`border-top:4px solid ${fam.color}`}
          >
            <h3 class="font-heading text-lg font-bold">
              {fam.title}{" "}
              <span class="text-muted-foreground text-sm font-normal">
                · {list.length}
              </span>
            </h3>
            <ul class="flex flex-col gap-1 text-sm">
              {list.map((s) => (
                <li class="flex gap-2">
                  <span class="text-muted-foreground w-8 shrink-0 tabular-nums">
                    {s.number}
                  </span>
                  {s.lesson ? (
                    <a
                      class="font-bold hover:underline"
                      href={`/lessons/${s.lesson.id}`}
                    >
                      {s.title}
                    </a>
                  ) : (
                    <span class="text-muted-foreground">{s.title}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
  </section>

  {next && (
    <div class="flex justify-end">
      <LinkButton href={`/levels/${next.toLowerCase()}`} variant="ghost">
        Next level: {next} · {LEVEL_INFO[next].title} →
      </LinkButton>
    </div>
  )}
</AppLayout>
