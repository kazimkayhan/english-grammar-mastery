---
import AppLayout from "@/layouts/AppLayout.astro"
import { SettingsPanel } from "@/components/settings/SettingsPanel"
---

<AppLayout title="Settings" description="Theme, reading comfort, Persian support and flashcard backup.">
  <header class="flex flex-col gap-3">
    <h1 class="font-heading text-4xl font-bold tracking-tight">Settings</h1>
    <p class="max-w-2xl text-muted-foreground">
      Everything is saved only in this browser. The app stores just two things: these settings and your flashcards.
    </p>
  </header>
  <SettingsPanel client:load />
</AppLayout>
