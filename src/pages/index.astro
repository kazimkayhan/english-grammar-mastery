---
import LinkButton from "@/components/common/link-button.astro";
import { DueBanner } from "@/components/flashcards/due-banner";
import AppLayout from "@/layouts/app-layout.astro";
import { getLessons, getLessonsByLevel, lessonHref } from "@/lib/content";
import {
  FAMILIES,
  FAMILY_INFO,
  LEVEL_INFO,
  LEVELS,
  pillarsOf,
} from "@/lib/taxonomy";

const lessons = await getLessons();
const byLevel = await getLessonsByLevel();
const [first] = lessons;
const planned = LEVELS.reduce((n, l) => n + LEVEL_INFO[l].lessons, 0);

const loop = [
  { min: 10, step: "Review", text: "Flashcards due today" },
  { min: 20, step: "Learn", text: "Rule → mindmap → examples → Persian help" },
  { min: 15, step: "Practice", text: "Exercises with instant feedback" },
  { min: 10, step: "Use it", text: "Write 3–5 sentences about your own life" },
  { min: 5, step: "Recall", text: "Redraw the mindmap from memory" },
];
---

<AppLayout title="Home">
  <section class="flex flex-col gap-5 pt-2">
    <p class="text-primary text-sm font-bold tracking-widest uppercase">
      A1 → C2 · grammar only · nothing left out
    </p>
    <h1
      class="font-heading max-w-3xl text-4xl font-bold tracking-tight text-balance sm:text-5xl lg:max-w-7xl"
    >
      Learn all of English grammar, one small step at a time.
    </h1>
    <p
      class="font-reading text-muted-foreground max-w-2xl text-lg lg:max-w-7xl"
    >
      {planned}
      short lessons take you from your first sentence to expert precision. Every
      lesson has one simple rule, a mindmap, real-life examples, help in Persian
      when you need it, exercises with instant feedback, and flashcards that
      come back right before you'd forget.
    </p>
    <div class="flex flex-wrap gap-3">
      {first && (
        <LinkButton href={lessonHref(first)} size="lg">
          Start with lesson {first.data.level}.{first.data.number}
        </LinkButton>
      )}
      <LinkButton href="/roadmap" size="lg" variant="outline"
        >See the whole roadmap</LinkButton
      >
      <LinkButton href="/flashcards" size="lg" variant="ghost"
        >Review flashcards</LinkButton
      >
    </div>
    <DueBanner client:idle />
  </section>

  <section aria-labelledby="families-title" class="flex flex-col gap-4">
    <h2 class="font-heading text-2xl font-bold" id="families-title">
      Grammar in four families: small → big
    </h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {FAMILIES.map((f, i) => {
        const fam = FAMILY_INFO[f];
        return (
          <div
            class="bg-card flex flex-col gap-3 rounded-3xl border p-5"
            style={`border-top:5px solid ${fam.color}`}
          >
            <div class="flex items-baseline gap-2">
              <span
                class="text-sm font-bold tabular-nums"
                style={`color:${fam.color}`}
              >
                {i + 1}
              </span>
              <h3 class="font-heading text-xl font-bold">{fam.title}</h3>
            </div>
            <p class="text-muted-foreground">{fam.tagline}</p>
            <ul class="flex flex-wrap gap-1.5">
              {pillarsOf(f).map((p) => (
                <li>
                  <a
                    class="inline-flex h-7 items-center gap-1.5 rounded-full px-3 text-sm font-bold"
                    href={`/pillars/${p.id}`}
                    style={`background:${fam.soft};color:${fam.color}`}
                  >
                    {p.number} {p.short}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
  </section>

  <section aria-labelledby="levels-title" class="flex flex-col gap-4">
    <h2 class="font-heading text-2xl font-bold" id="levels-title">
      Six levels
    </h2>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {LEVELS.map((l) => (
        <a
          class="bg-card hover:bg-muted/50 flex flex-col gap-2 rounded-2xl border p-4 transition-colors"
          href={`/levels/${l.toLowerCase()}`}
        >
          <span class="flex items-baseline justify-between">
            <span class="font-heading text-2xl font-bold">{l}</span>
            <span class="text-muted-foreground text-sm">
              {byLevel[l].length}/{LEVEL_INFO[l].lessons} lessons ·{" "}
              {LEVEL_INFO[l].weeks} wk
            </span>
          </span>
          <span class="font-bold">{LEVEL_INFO[l].title}</span>
          <span class="text-muted-foreground text-sm">
            {LEVEL_INFO[l].canDo}
          </span>
        </a>
      ))}
    </div>
  </section>

  <section aria-labelledby="loop-title" class="flex flex-col gap-4">
    <h2 class="font-heading text-2xl font-bold" id="loop-title">
      Your daily hour
    </h2>
    <p class="text-muted-foreground">
      The same five steps every day, so studying becomes a habit you don't have
      to think about.
    </p>
    <ol class="grid gap-3 sm:grid-cols-5">
      {loop.map((s) => (
        <li class="bg-card flex flex-col gap-1 rounded-2xl border p-4">
          <span class="text-primary text-2xl font-bold tabular-nums">
            {s.min}′
          </span>
          <span class="font-bold">{s.step}</span>
          <span class="text-muted-foreground text-sm">{s.text}</span>
        </li>
      ))}
    </ol>
  </section>
</AppLayout>
