---
import AppLayout from "@/layouts/app-layout.astro";
import { getCoverage, getInventory, getSyllabus } from "@/lib/content";
import { FAMILY_INFO, PILLAR_INFO, type Pillar } from "@/lib/taxonomy";

const points = await getInventory();
const syllabus = new Map((await getSyllabus()).map((s) => [s.id, s]));
const { taughtBy } = await getCoverage();

// One entry per title and per alias, like the index at the back of a book.
// Sort on the first letter or digit, so "-ed spelling" files under E, not before A.
const LEADING_NON_ALPHANUMERIC = /^[^a-z0-9]+/iu;
const LETTER = /[A-Z]/u;
const sortKey = (term: string) => term.replace(LEADING_NON_ALPHANUMERIC, "");
const entries = points
  .flatMap((p) =>
    [p.title, ...p.aliases].map((term) => ({
      alias: term !== p.title,
      point: p,
      term,
    }))
  )
  .sort((a, b) =>
    sortKey(a.term).localeCompare(sortKey(b.term), "en", {
      sensitivity: "base",
    })
  );

const letterOf = (term: string) => {
  const c = sortKey(term)[0]?.toUpperCase() ?? "#";
  return LETTER.test(c) ? c : "#";
};
const letters = [...new Set(entries.map((e) => letterOf(e.term)))];
---

<AppLayout
  description="Every grammar point from A1 to C2, A to Z."
  title="Grammar index"
>
  <header class="flex flex-col gap-3">
    <h1 class="font-heading text-4xl font-bold tracking-tight">
      Grammar index
    </h1>
    <p
      class="font-reading text-muted-foreground max-w-2xl text-lg lg:max-w-7xl"
    >
      All {points.length} grammar points in the course, A to Z, with their other
      names. Each one links to the lesson that teaches it.
    </p>
    <div class="flex max-w-md flex-col gap-1.5">
      <label class="text-sm font-bold" for="index-filter"
        >Filter the index</label
      >
      <input
        autocomplete="off"
        class="border-input bg-input/30 focus-visible:border-ring focus-visible:ring-ring/50 h-10 w-full rounded-4xl border px-4 text-base outline-none focus-visible:ring-[3px]"
        id="index-filter"
        placeholder="e.g. perfect, article, if"
        type="search"
      >
      <p
        aria-live="polite"
        class="text-muted-foreground text-sm"
        id="index-count"
      ></p>
    </div>
    <nav aria-label="Letters" class="flex flex-wrap gap-1">
      {letters.map((l) => (
        <a
          class="bg-card hover:bg-muted/50 flex size-8 items-center justify-center rounded-lg border text-sm font-bold"
          href={`#letter-${l}`}
        >
          {l}
        </a>
      ))}
    </nav>
  </header>

  {letters.map((letter) => (
    <section class="index-letter flex flex-col gap-2" id={`letter-${letter}`}>
      <h2 class="font-heading text-2xl font-bold">{letter}</h2>
      <ul class="grid gap-x-6 gap-y-1 sm:grid-cols-2">
        {entries
          .filter((e) => letterOf(e.term) === letter)
          .map(({ term, point, alias }) => {
            const by = taughtBy.get(point.id) ?? [];
            const planned = syllabus.get(point.lesson);
            const fam = FAMILY_INFO[PILLAR_INFO[point.pillar as Pillar].family];
            return (
              <li
                class="index-entry flex items-baseline gap-2 border-b border-dashed py-1.5 text-sm"
                data-term={`${term} ${point.title}`.toLowerCase()}
              >
                <span
                  aria-hidden="true"
                  class="size-2 shrink-0 rounded-full"
                  style={`background:${fam.color}`}
                />
                <span class="min-w-0 flex-1">
                  {by.length ? (
                    <a
                      class="font-bold hover:underline"
                      href={`/lessons/${by[0]}`}
                    >
                      {term}
                    </a>
                  ) : (
                    <span>{term}</span>
                  )}
                  {alias ? (
                    <span class="text-muted-foreground"> → {point.title}</span>
                  ) : null}
                </span>
                <span class="text-muted-foreground shrink-0 text-xs tabular-nums">
                  {planned ? `${planned.level}.${planned.number}` : point.level}
                </span>
              </li>
            );
          })}
      </ul>
    </section>
  ))}
  <p class="text-muted-foreground hidden" id="index-empty">
    No grammar point matches that. Try a shorter word.
  </p>
</AppLayout>

<script>
  // Instant filter over the static index (nothing is stored).
  const WHITESPACE = /\s+/u;
  const input = document.querySelector(
    "#index-filter"
  ) as HTMLInputElement | null;
  const count = document.querySelector("#index-count");
  const empty = document.querySelector("#index-empty");
  const entries = [...document.querySelectorAll<HTMLElement>(".index-entry")];
  const sections = [...document.querySelectorAll<HTMLElement>(".index-letter")];
  input?.addEventListener("input", () => {
    const words = input.value.toLowerCase().split(WHITESPACE).filter(Boolean);
    let shown = 0;
    for (const li of entries) {
      const match = words.every((w) => li.dataset.term?.includes(w));
      li.hidden = !match;
      if (match) {
        shown += 1;
      }
    }
    for (const s of sections) {
      s.hidden = !s.querySelector(".index-entry:not([hidden])");
    }
    if (count) {
      count.textContent = words.length
        ? `${shown} ${shown === 1 ? "entry" : "entries"}`
        : "";
    }
    empty?.classList.toggle("hidden", shown > 0);
  });
</script>
