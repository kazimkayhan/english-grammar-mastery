---
import { getCollection } from "astro:content";
import SyllabusList from "@/components/common/syllabus-list.astro";
import MapEmbed from "@/components/lesson/map-embed.astro";
import TreeEmbed from "@/components/lesson/tree-embed.astro";
import AppLayout from "@/layouts/app-layout.astro";
import { getCoverage, getInventory, getSyllabus } from "@/lib/content";
import {
  FAMILY_INFO,
  LEVELS,
  PILLAR_INFO,
  PILLARS,
  type Pillar,
} from "@/lib/taxonomy";
import { plural } from "@/lib/text";

export function getStaticPaths() {
  return PILLARS.map((name) => ({
    params: { pillar: name },
    props: { pillar: name },
  }));
}

const { pillar } = Astro.props as { pillar: Pillar };
const info = PILLAR_INFO[pillar];
const fam = FAMILY_INFO[info.family];
const items = (await getSyllabus()).filter((s) => s.pillar === pillar);
const points = (await getInventory()).filter((p) => p.pillar === pillar);
const { taughtBy } = await getCoverage();
const trees = (await getCollection("trees")).filter(
  (t) => t.data.pillar === pillar
);
---

<AppLayout description={info.covers} title={info.title}>
  <header
    class="flex flex-col gap-3"
    style={`--lesson-color:${fam.color};--lesson-soft:${fam.soft}`}
  >
    <p
      class="text-sm font-bold tracking-widest uppercase"
      style={`color:${fam.color}`}
    >
      {fam.title}
      · pillar {info.number} of 16
    </p>
    <h1 class="font-heading text-4xl font-bold tracking-tight">{info.title}</h1>
    <p
      class="font-reading text-muted-foreground max-w-2xl text-lg lg:max-w-7xl"
    >
      {info.covers}
    </p>
    <p class="text-muted-foreground text-sm">
      {plural(items.length, "lesson")}
      from {items[0]?.level ?? "A1"} to {items.at(-1)?.level ?? "C2"} ·
      {plural(points.length, "grammar point")}
    </p>
  </header>

  <section aria-labelledby="pmap-title" class="flex flex-col gap-3">
    <h2 class="font-heading text-2xl font-bold" id="pmap-title">
      Mindmap: {info.short} from A1 to C2
    </h2>
    <p class="text-muted-foreground">
      Starts folded: recall each level's points, then open the branch to check.
    </p>
    <MapEmbed height={520} id={`pillar-${pillar}`} recall />
  </section>

  {trees.length > 0 && (
    <section aria-labelledby="trees-title" class="flex flex-col gap-3">
      <h2 class="font-heading text-2xl font-bold" id="trees-title">
        Decision trees
      </h2>
      <div class="grid gap-4">
        {trees.map((t) => (
          <TreeEmbed id={t.id} />
        ))}
      </div>
    </section>
  )}

  <section aria-labelledby="plessons-title" class="flex flex-col gap-3">
    <h2 class="font-heading text-2xl font-bold" id="plessons-title">
      Lessons in this pillar
    </h2>
    <SyllabusList items={items} showLevel showPillar={false} />
  </section>

  <section aria-labelledby="points-title" class="flex flex-col gap-3">
    <h2 class="font-heading text-2xl font-bold" id="points-title">
      Every grammar point
    </h2>
    <p class="text-muted-foreground">
      The complete checklist for this pillar. Nothing is left out.
    </p>
    {LEVELS.map((level) => {
      const list = points.filter((p) => p.level === level);
      if (!list.length) {
        return null;
      }
      return (
        <div class="flex flex-col gap-2">
          <h3 class="font-heading font-bold">{level}</h3>
          <ul class="grid gap-1.5 sm:grid-cols-2">
            {list.map((p) => {
              const by = taughtBy.get(p.id) ?? [];
              return (
                <li class="bg-card flex items-start gap-2 rounded-xl border px-3 py-2 text-sm">
                  <span
                    aria-hidden="true"
                    class={by.length ? "text-success" : "text-muted-foreground"}
                  >
                    {by.length ? "●" : "○"}
                  </span>
                  {by.length ? (
                    <a class="hover:underline" href={`/lessons/${by[0]}`}>
                      {p.title}
                    </a>
                  ) : (
                    <span class="text-muted-foreground">{p.title}</span>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      );
    })}
  </section>
</AppLayout>
