---
import SyllabusList from "@/components/common/syllabus-list.astro";
import MapEmbed from "@/components/lesson/map-embed.astro";
import AppLayout from "@/layouts/app-layout.astro";
import { getSyllabus, sizeMinutes } from "@/lib/content";
import { LEVEL_INFO, LEVELS } from "@/lib/taxonomy";
import { isAre, plural } from "@/lib/text";

const syllabus = await getSyllabus();
const published = syllabus.filter((s) => s.lesson).length;
const hours = Math.round(
  syllabus.reduce((n, s) => n + sizeMinutes(s.size), 0) / 60
);
const weeks = LEVELS.reduce((n, l) => n + LEVEL_INFO[l].weeks, 0);
---

<AppLayout
  description="The whole A1 → C2 grammar course on one page."
  title="Roadmap"
>
  <header class="flex flex-col gap-3">
    <h1 class="font-heading text-4xl font-bold tracking-tight">The roadmap</h1>
    <p
      class="font-reading text-muted-foreground max-w-2xl text-lg lg:max-w-7xl"
    >
      {syllabus.length}
      lessons from A1 to C2: about {hours} hours of lessons, or roughly
      {weeks}
      weeks at one hour a day (including the review week at the end of each
      level). {plural(published, "lesson")} {isAre(published)} ready now.
    </p>
  </header>

  <section aria-labelledby="master-title" class="flex flex-col gap-3">
    <h2 class="font-heading text-2xl font-bold" id="master-title">
      All of English grammar on one page
    </h2>
    <p class="text-muted-foreground">
      Four families, small to big: Words → Verbs → Sentences → Text. Turn on
      Recall mode, say each branch aloud, then open it to check.
    </p>
    <MapEmbed height={520} id="master" />
  </section>

  {LEVELS.map((level) => {
    const items = syllabus.filter((s) => s.level === level);
    const ready = items.filter((s) => s.lesson).length;
    return (
      <section aria-labelledby={`level-${level}`} class="flex flex-col gap-3">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="font-heading text-2xl font-bold" id={`level-${level}`}>
            <a class="hover:underline" href={`/levels/${level.toLowerCase()}`}>
              {level} · {LEVEL_INFO[level].title}
            </a>
          </h2>
          <span class="text-muted-foreground text-sm">
            {ready}/{items.length} ready · {LEVEL_INFO[level].weeks} weeks
          </span>
        </div>
        <p class="text-muted-foreground">{LEVEL_INFO[level].canDo}</p>
        <details class="group">
          <summary class="text-primary cursor-pointer text-sm font-bold select-none">
            Show all {items.length} lessons
          </summary>
          <div class="pt-3">
            <SyllabusList items={items} />
          </div>
        </details>
      </section>
    );
  })}
</AppLayout>
