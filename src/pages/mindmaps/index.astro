---
import { getCollection } from "astro:content";

import AppLayout from "@/layouts/app-layout.astro";
import { getAllMaps } from "@/lib/maps";
import { FAMILY_INFO, PILLAR_INFO } from "@/lib/taxonomy";

const maps = await getAllMaps();
const trees = await getCollection("trees");
const KINDS = [
  {
    kind: "master",
    text: "All of English grammar on one page.",
    title: "Master map",
  },
  {
    kind: "family",
    text: "Words, Verbs, Sentences and Text.",
    title: "Family maps",
  },
  { kind: "pillar", text: "One topic from A1 to C2.", title: "Pillar maps" },
  { kind: "level", text: "What's new at each level.", title: "Level maps" },
] as const;
---

<AppLayout
  description="Mindmaps and decision trees for every part of English grammar."
  title="Mindmaps"
>
  <header class="flex flex-col gap-3">
    <h1 class="font-heading text-4xl font-bold tracking-tight">Mindmaps</h1>
    <p
      class="font-reading text-muted-foreground max-w-2xl text-lg lg:max-w-7xl"
    >
      See the shape of the grammar, then test yourself: turn on
      <strong>Recall mode</strong>, say each branch aloud, and click to check.
      One review like this beats five re-readings.
    </p>
  </header>

  {KINDS.map(({ kind, title, text }) => {
    const list = maps.filter((m) => m.kind === kind);
    if (!list.length) {
      return null;
    }
    return (
      <section class="flex flex-col gap-3">
        <div>
          <h2 class="font-heading text-2xl font-bold">{title}</h2>
          <p class="text-muted-foreground">{text}</p>
        </div>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {list.map((m) => (
            <a
              class="bg-card hover:bg-muted/50 flex flex-col gap-1 rounded-2xl border p-4 transition-colors"
              href={`/mindmaps/${m.id}`}
              style={
                m.colorVar
                  ? `border-left:4px solid var(${m.colorVar})`
                  : undefined
              }
            >
              <span class="font-bold">{m.title}</span>
              <span class="text-muted-foreground text-sm">{m.description}</span>
            </a>
          ))}
        </div>
      </section>
    );
  })}

  {trees.length > 0 && (
    <section class="flex flex-col gap-3">
      <div>
        <h2 class="font-heading text-2xl font-bold">Decision trees</h2>
        <p class="text-muted-foreground">
          Answer one question at a time until the right form appears.
        </p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {trees.map((t) => {
          const fam = FAMILY_INFO[PILLAR_INFO[t.data.pillar].family];
          return (
            <a
              class="bg-card hover:bg-muted/50 flex flex-col gap-1 rounded-2xl border p-4 transition-colors"
              href={`/pillars/${t.data.pillar}#trees-title`}
              style={`border-left:4px solid ${fam.color}`}
            >
              <span class="font-bold">{t.data.title}</span>
              <span class="text-muted-foreground text-sm">
                {t.data.description}
              </span>
            </a>
          );
        })}
      </div>
    </section>
  )}
</AppLayout>
