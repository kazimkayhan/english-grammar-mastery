---
// Runs before first paint so the page never flashes the wrong theme.
---

<script is:inline>
  ;(function () {
    var s = {}
    try {
      s = JSON.parse(localStorage.getItem("egm-settings") || "{}")
    } catch (e) {}
    var root = document.documentElement
    var theme = s.theme || "system"
    if (theme === "system") theme = matchMedia("(prefers-color-scheme: dark)").matches ? "night" : "paper"
    root.dataset.theme = theme
    if (theme === "night") root.classList.add("dark")
    root.dataset.readingFont = s.readingFont || "sans"
    root.dataset.persian = s.persian || "auto"
    root.dataset.focus = s.focus ? "on" : "off"
    if (s.fontScale) root.style.setProperty("--font-scale", String(s.fontScale))
  })()
</script>
