---
// A link styled with the shadcn button variants (for static Astro pages).
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"

interface Props {
  href: string
  variant?: "default" | "outline" | "secondary" | "ghost" | "link"
  size?: "default" | "sm" | "lg" | "xs"
  class?: string
}

const { href, variant = "default", size = "default", class: className } = Astro.props
---

<a href={href} data-slot="button" class={cn(buttonVariants({ variant, size }), className)}><slot /></a>
