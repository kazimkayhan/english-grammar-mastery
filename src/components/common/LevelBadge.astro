---
import { LEVEL_INFO, type Level } from "@/lib/taxonomy"

interface Props {
  level: Level
  link?: boolean
  showTitle?: boolean
}

const { level, link = true, showTitle = false } = Astro.props
const Tag = link ? "a" : "span"
---

<Tag
  href={link ? `/levels/${level.toLowerCase()}` : undefined}
  class="inline-flex h-6 items-center gap-1.5 rounded-full border bg-background px-2.5 text-xs font-bold whitespace-nowrap"
  title={`${level} · ${LEVEL_INFO[level].title}`}
>
  {level}
  {showTitle && <span class="font-normal text-muted-foreground">{LEVEL_INFO[level].title}</span>}
</Tag>
