---
import type { PlannedLesson } from "@/lib/content"
import { FAMILY_INFO, PILLAR_INFO, type Pillar } from "@/lib/taxonomy"

interface Props {
  items: PlannedLesson[]
  showLevel?: boolean
  showPillar?: boolean
}

const { items, showLevel = false, showPillar = true } = Astro.props
---

<ol class="flex flex-col divide-y rounded-2xl border bg-card">
  {
    items.map((item) => {
      const pillar = PILLAR_INFO[item.pillar as Pillar]
      const fam = FAMILY_INFO[pillar.family]
      const Tag = item.lesson ? "a" : "div"
      return (
        <li>
          <Tag
            href={item.lesson ? `/lessons/${item.lesson.id}` : undefined}
            class:list={[
              "flex items-center gap-3 px-4 py-3",
              item.lesson ? "transition-colors hover:bg-muted/50" : "text-muted-foreground",
            ]}
          >
            <span
              class="flex h-7 min-w-12 shrink-0 items-center justify-center rounded-lg text-xs font-bold tabular-nums"
              style={`background:${fam.soft};color:${fam.color}`}
            >
              {showLevel ? `${item.level}.${item.number}` : item.number}
            </span>
            <span class:list={["min-w-0 flex-1", item.lesson && "font-bold text-foreground"]}>{item.title}</span>
            {showPillar && (
              <span class="hidden shrink-0 text-xs text-muted-foreground md:inline">{pillar.short}</span>
            )}
            <span class="hidden shrink-0 text-xs text-muted-foreground sm:inline">{item.size === "core" ? "Core" : "Mini"}</span>
            {item.lesson ? (
              <span class="shrink-0 rounded-full bg-success-soft px-2 py-0.5 text-xs font-bold text-success">Open</span>
            ) : (
              <span class="shrink-0 rounded-full bg-muted px-2 py-0.5 text-xs">
                <span class="sm:hidden">Soon</span>
                <span class="hidden sm:inline">Coming soon</span>
              </span>
            )}
          </Tag>
        </li>
      )
    })
  }
</ol>
