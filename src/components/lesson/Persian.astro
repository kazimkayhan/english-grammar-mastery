---
// Persian support. A1–A2: kind="full" (a complete explanation, open by default).
// B1–B2: kind="tip" (one or two lines). C1–C2 lessons don't use it.
// English examples inside the Persian text are isolated automatically (see lib/bidi).
import { isolateLatinHtml } from "@/lib/bidi"

interface Props {
  kind?: "full" | "tip"
  title?: string
}
const { kind = "full", title } = Astro.props
const body = isolateLatinHtml(await Astro.slots.render("default"))
---

{
  kind === "full" ? (
    <details open class="persian-only persian-block group rounded-2xl border border-persian/30 bg-persian-soft not-prose">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-5 py-3 font-sans text-sm font-bold text-persian select-none">
        <span>
          Persian explanation · <span lang="fa">توضیح فارسی</span>
        </span>
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 shrink-0 text-persian transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
      </summary>
      <div lang="fa" dir="rtl" class="fa px-5 pb-5 text-[1.05em] text-foreground [&_p+p]:mt-3 [&_strong]:font-bold [&_ul]:list-disc [&_ul]:pr-5 [&_li+li]:mt-1">
        {title && <p class="mb-2 font-bold">{title}</p>}
        <Fragment set:html={body} />
      </div>
    </details>
  ) : (
    <aside class="persian-only persian-block flex gap-3 rounded-2xl border border-persian/30 bg-persian-soft px-5 py-3 not-prose">
      <span class="mt-1 shrink-0 font-sans text-xs font-bold tracking-wide text-persian uppercase">فارسی</span>
      <div lang="fa" dir="rtl" class="fa flex-1 text-[0.98em] text-foreground">
        <Fragment set:html={body} />
      </div>
    </aside>
  )
}
