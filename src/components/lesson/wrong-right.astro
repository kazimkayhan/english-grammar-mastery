---
import LessonRef from "@/components/lesson/lesson-ref.astro";
import { isolateLatinText } from "@/lib/bidi";
import { splitLessonRefs } from "@/lib/lesson-refs";

// ✗ common mistake → ✓ correct English, with a one-line reason.
interface Props {
  fa?: string;
  right: string;
  why?: string;
  wrong: string;
}
const { wrong, right, why, fa } = Astro.props;
---

<div
  class="wrong-right not-prose bg-card grid gap-2 rounded-2xl border p-4 font-sans text-[0.98em] sm:grid-cols-2"
>
  <p class="bg-mistake-soft flex items-start gap-2 rounded-xl px-3 py-2">
    <span aria-hidden="true" class="text-mistake font-bold">✗</span>
    <span
      ><span class="sr-only">Wrong: </span
      ><s class="decoration-mistake/60">{wrong}</s></span
    >
  </p>
  <p class="bg-success-soft flex items-start gap-2 rounded-xl px-3 py-2">
    <span aria-hidden="true" class="text-success font-bold">✓</span>
    <span><span class="sr-only">Right: </span><strong>{right}</strong></span>
  </p>
  {why && (
    <p class="text-muted-foreground text-sm sm:col-span-2">
      {splitLessonRefs(why).map((part) =>
        part.ref ? <LessonRef>{part.text}</LessonRef> : part.text
      )}
    </p>
  )}
  {fa && (
    <p
      class="fa persian-only text-muted-foreground text-sm sm:col-span-2"
      dir="rtl"
      lang="fa"
      set:html={isolateLatinText(fa)}
    />
  )}
</div>
