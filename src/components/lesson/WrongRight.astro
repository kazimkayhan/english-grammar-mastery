---
import LessonRef from "@/components/lesson/LessonRef.astro"
import { isolateLatinText } from "@/lib/bidi"
import { splitLessonRefs } from "@/lib/lesson-refs"
// ✗ common mistake → ✓ correct English, with a one-line reason.
interface Props {
  wrong: string
  right: string
  why?: string
  fa?: string
}
const { wrong, right, why, fa } = Astro.props
---

<div class="wrong-right not-prose grid gap-2 rounded-2xl border bg-card p-4 font-sans text-[0.98em] sm:grid-cols-2">
  <p class="flex items-start gap-2 rounded-xl bg-mistake-soft px-3 py-2">
    <span aria-hidden="true" class="font-bold text-mistake">✗</span>
    <span><span class="sr-only">Wrong: </span><s class="decoration-mistake/60">{wrong}</s></span>
  </p>
  <p class="flex items-start gap-2 rounded-xl bg-success-soft px-3 py-2">
    <span aria-hidden="true" class="font-bold text-success">✓</span>
    <span><span class="sr-only">Right: </span><strong>{right}</strong></span>
  </p>
  {
    why && (
      <p class="text-sm text-muted-foreground sm:col-span-2">
        {splitLessonRefs(why).map((part) => (part.ref ? <LessonRef>{part.text}</LessonRef> : part.text))}
      </p>
    )
  }
  {fa && <p lang="fa" dir="rtl" class="fa persian-only text-sm text-muted-foreground sm:col-span-2" set:html={isolateLatinText(fa)} />}
</div>
