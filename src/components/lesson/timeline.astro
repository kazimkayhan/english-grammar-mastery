---
// Visual timeline for tenses: PAST ── NOW ── FUTURE.
// Positions run from -1 (far past) through 0 (now) to 1 (far future).
type Item =
  | { type: "point"; at: number; label?: string }
  | { type: "span"; from: number; to: number; label?: string }
  | { type: "wave"; from: number; to: number; label?: string }
  | { type: "repeat"; from: number; to: number; label?: string }
  | { type: "arrow"; from: number; to: number; label?: string };

interface Props {
  caption?: string;
  items: Item[];
  /** Optional second reference point, e.g. "then" for past perfect. */
  marker?: { at: number; label: string };
}

const { items, caption, marker } = Astro.props;
const X = (v: number) => 300 + Math.max(-1, Math.min(1, v)) * 250;
const AXIS_Y = 78;

const wavePath = (from: number, to: number) => {
  const x1 = X(from);
  const x2 = X(to);
  const steps = Math.max(2, Math.round((x2 - x1) / 14));
  const w = (x2 - x1) / steps;
  let d = `M ${x1} ${AXIS_Y - 14}`;
  for (let i = 0; i < steps; i += 1) {
    d += ` q ${w / 2} ${i % 2 ? 8 : -8} ${w} 0`;
  }
  return d;
};

const repeats = (from: number, to: number) => {
  const n = Math.max(3, Math.round((X(to) - X(from)) / 34));
  return Array.from(
    { length: n },
    (_, i) => X(from) + ((X(to) - X(from)) * i) / (n - 1)
  );
};

const labelX = (item: Item) =>
  "at" in item ? X(item.at) : (X(item.from) + X(item.to)) / 2;
---

<figure
  class="timeline not-prose bg-card flex flex-col gap-2 rounded-2xl border p-3 sm:p-4"
>
  <svg
    aria-label={caption ?? "Timeline"}
    class="h-auto w-full font-sans"
    role="img"
    viewBox="0 0 600 120"
  >
    <defs>
      <marker
        id="tl-head"
        markerHeight="7"
        markerWidth="7"
        orient="auto-start-reverse"
        refX="8"
        refY="5"
        viewBox="0 0 10 10"
      >
        <path d="M0,0 L10,5 L0,10 z" fill="var(--muted-foreground)"></path>
      </marker>
      <marker
        id="tl-head-accent"
        markerHeight="7"
        markerWidth="7"
        orient="auto-start-reverse"
        refX="8"
        refY="5"
        viewBox="0 0 10 10"
      >
        <path
          d="M0,0 L10,5 L0,10 z"
          fill="var(--lesson-color, var(--primary))"
        ></path>
      </marker>
    </defs>

    <line
      marker-end="url(#tl-head)"
      stroke="var(--muted-foreground)"
      stroke-width="2"
      x1="24"
      x2="582"
      y1={AXIS_Y}
      y2={AXIS_Y}
    ></line>
    <line
      stroke="var(--foreground)"
      stroke-dasharray="4 4"
      stroke-width="1.5"
      x1="300"
      x2="300"
      y1="28"
      y2="102"
    ></line>
    <text
      fill="var(--muted-foreground)"
      font-size="13"
      font-weight="700"
      letter-spacing="1"
      x="50"
      y="110"
    >
      PAST
    </text>
    <text
      fill="var(--foreground)"
      font-size="13"
      font-weight="700"
      letter-spacing="1"
      text-anchor="middle"
      x="300"
      y="118"
    >
      NOW
    </text>
    <text
      fill="var(--muted-foreground)"
      font-size="13"
      font-weight="700"
      letter-spacing="1"
      text-anchor="end"
      x="550"
      y="110"
    >
      FUTURE
    </text>

    {marker && (
      <g>
        <line
          stroke="var(--muted-foreground)"
          stroke-dasharray="2 4"
          stroke-width="1.5"
          x1={X(marker.at)}
          x2={X(marker.at)}
          y1="40"
          y2="96"
        />
        <text
          fill="var(--muted-foreground)"
          font-size="12"
          font-weight="700"
          text-anchor="middle"
          x={X(marker.at)}
          y="110"
        >
          {marker.label}
        </text>
      </g>
    )}

    {items.map((item) => (
      <g
        fill="var(--lesson-color, var(--primary))"
        stroke="var(--lesson-color, var(--primary))"
      >
        {item.type === "point" && (
          <circle
            cx={X(item.at)}
            cy={AXIS_Y}
            r="8"
            stroke="var(--card)"
            stroke-width="3"
          />
        )}
        {item.type === "span" && (
          <rect
            height="12"
            opacity="0.85"
            rx="6"
            stroke="none"
            width={Math.max(4, X(item.to) - X(item.from))}
            x={X(item.from)}
            y={AXIS_Y - 6}
          />
        )}
        {item.type === "wave" && (
          <path
            d={wavePath(item.from, item.to)}
            fill="none"
            stroke-linecap="round"
            stroke-width="3"
          />
        )}
        {item.type === "repeat" &&
          repeats(item.from, item.to).map((x) => (
            <path
              d={`M ${x - 5} ${AXIS_Y - 5} L ${x + 5} ${AXIS_Y + 5} M ${x + 5} ${AXIS_Y - 5} L ${x - 5} ${AXIS_Y + 5}`}
              stroke-linecap="round"
              stroke-width="3"
            />
          ))}
        {item.type === "arrow" && (
          <line
            marker-end="url(#tl-head-accent)"
            stroke-width="3"
            x1={X(item.from)}
            x2={X(item.to)}
            y1={AXIS_Y - 16}
            y2={AXIS_Y - 16}
          />
        )}
        {item.label ? (
          <text
            fill="var(--foreground)"
            font-size="14"
            font-weight="700"
            stroke="none"
            text-anchor="middle"
            x={labelX(item)}
            y={item.type === "arrow" || item.type === "wave" ? 34 : 50}
          >
            {item.label}
          </text>
        ) : null}
      </g>
    ))}
  </svg>
  {caption && (
    <figcaption class="text-muted-foreground font-sans text-sm">
      {caption}
    </figcaption>
  )}
</figure>
