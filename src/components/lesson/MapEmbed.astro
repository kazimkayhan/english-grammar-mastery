---
// <MapEmbed id="master" /> shows any mindmap: hand-written (src/content/mindmaps) or generated
// (family-*, pillar-*, level-*; see lib/maps).
import { Mindmap } from "@/components/mindmap/Mindmap"
import { getMap } from "@/lib/maps"

interface Props {
  id: string
  height?: number
  /** Start folded (Recall mode). */
  recall?: boolean
}

const map = await getMap(Astro.props.id)
if (!map) throw new Error(`Mindmap "${Astro.props.id}" not found`)
---

<Mindmap
  client:visible
  markdown={map.markdown}
  colors={map.colors}
  colorVar={map.colorVar}
  branchColors={map.branchColors}
  title={map.title}
  height={Astro.props.height ?? 420}
  recallDefault={Astro.props.recall ?? false}
/>
