---
// <DecisionTree id="articles" /> inside a lesson: loads the tree from src/content/trees.
import { getEntry } from "astro:content"

import { DecisionTree } from "@/components/mindmap/DecisionTree"
import { PILLAR_INFO } from "@/lib/taxonomy"

interface Props {
  id: string
}

const entry = await getEntry("trees", Astro.props.id)
if (!entry) throw new Error(`Decision tree "${Astro.props.id}" not found in src/content/trees`)
const family = PILLAR_INFO[entry.data.pillar].family
---

<DecisionTree
  client:visible
  title={entry.data.title}
  description={entry.data.description}
  root={entry.data.root}
  colorVar={`--fam-${family}`}
/>
